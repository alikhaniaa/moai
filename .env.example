# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./dev.db"
SESSION_SECRET=""              # long random string, e.g. openssl rand -hex 32
SITE_URL="http://localhost:3000"

# Development helpers
OTP_DEV_ECHO=1                 # show the one-time login code on the page instead of sending SMS
SEP_SANDBOX=1                  # use the local fake card gateway instead of the bank

# Card gateway (Saman / SEP)
SEP_TERMINAL_ID=

# SMS (one-time codes)
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMS_PARAM_NAME=

# Instalment gateways (optional)
SNAPPPAY_ENABLED=0
SNAPPPAY_BASE_URL=
SNAPPPAY_CLIENT_ID=
SNAPPPAY_CLIENT_SECRET=
SNAPPPAY_USERNAME=
SNAPPPAY_PASSWORD=
DIGIPAY_ENABLED=0
DIGIPAY_BASE=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=

# Order alerts to the shop owner (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
